# ============================================================
# MEVACOL — Variables de Entorno del Backend
# ============================================================
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas el archivo .env real al repositorio.
# ============================================================

# Entorno de ejecución: development | production
NODE_ENV=development

# Puerto del servidor Express (por defecto 4000)
PORT=4000

# Secreto para firmar tokens JWT.
# OBLIGATORIO en producción. Usa un valor aleatorio largo y seguro.
# Ejemplo (Linux/Mac): openssl rand -hex 64
JWT_SECRET=cambia_esto_por_un_secreto_seguro_y_largo

# URL de conexión a PostgreSQL.
# Desarrollo local:  postgresql://postgres:postgres@localhost:5432/mevacol
# Neon.tech (prod):  postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# Obtén la cadena en: Neon Dashboard → tu proyecto → Connection Details → Connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mevacol

# Orígenes CORS permitidos.
# En desarrollo puede ser * (todos).
# En producción especifica solo los dominios del frontend, separados por coma.
# Ejemplo: https://tu-usuario.github.io,https://tu-usuario.github.io/mevacol-2026
CORS_ORIGIN=*
